Panels: []
Visualization Manager:
  Class: ''
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: XY Grid
      Enabled: true
      Alpha: 0.15
      Cell Size: 1
      Plane Cell Count: 100
      Reference Frame: spot1/nav_base_link
    - Class: rviz_default_plugins/Image
      Name: RGB + Target
      Enabled: true
      Normalize Range: false
      Topic:
        Value: /wildos/review/camera
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Alpha: 0.35
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Nearby Obstacle Costmap
      Enabled: true
      Alpha: 0.45
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Measured Obstacle Points
      Enabled: true
      Style: Points
      Size (Pixels): 2
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 195; 200; 210
      Alpha: 0.65
      Decay Time: 0
      Topic:
        Value: /wildos/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Graph Nodes
      Enabled: true
      Namespaces:
        nodes: true
        edges: true
        frontier_nodes_default: true
        explored_radius: false
        free_radius_default: false
        frontier_points: false
        frontier_point_to_node: false
        relative_positions: false
        ids: false
      Topic:
        Value: /spot1/nav_graph_viz
        Depth: 1
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/MarkerArray
      Name: Frontiers
      Enabled: false
      Topic:
        Value: /spot1/within_range_geofrontiers
        Depth: 1
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Path
      Name: GraphNav Route
      Enabled: true
      Color: 80; 150; 255
      Line Style: Lines
      Line Width: 0.25
      Topic:
        Value: /spot1/graphnav_planner/path
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Vehicle Plan
      Enabled: true
      Color: 255; 210; 60
      Line Style: Lines
      Line Width: 0.30
      Topic:
        Value: /plan
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Polygon
      Name: Vehicle Footprint
      Enabled: true
      Color: 0; 255; 255
      Topic:
        Value: /local_costmap/published_footprint
        Reliability Policy: Best Effort
        Depth: 1
    - Class: rviz_default_plugins/Marker
      Name: Confirmed Target
      Enabled: false
      Topic:
        Value: /spot1/triangulated_object
        Depth: 1
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/MarkerArray
      Name: Target Name and Arrival Region
      Enabled: true
      Topic:
        Value: /wildos/review/target
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
  Enabled: true
  Global Options:
    Background Color: 38; 42; 48
    Fixed Frame: spot1/odom
    Frame Rate: 12
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Scale: 9
      X: 0
      Y: 0
      Target Frame: spot1/nav_base_link
      Near Clip Distance: 0.01
      Name: Current View
      Value: TopDownOrtho (rviz)
Window Geometry:
  Width: 1920
  Height: 1080
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: false
  RGB + Target:
    collapsed: false
  QMainWindow State: 000000ff00000000fd0000000100000001000003bd00000427fc0200000001fb000000180052004700420020002b00200054006100720067006500740100000011000004270000001000ffffff000003bd0000042700000004000000040000000800000008fc0000000100000002000000010000000a0054006f006f006c00730100000000ffffffff0000000000000000
