{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "WildOS 视觉记忆与 Heading 决策闭环",
    "locale": "zh-CN",
    "output": "visual-memory-heading.html",
    "quality_profile": "showcase",
    "viewBox": [1900, 1000],
    "views": [
      {
        "id": "main-loop",
        "label": "主处理链",
        "focus": ["inputs", "perception", "anchor", "memory", "heading", "planner", "execution"],
        "note": "视觉观测绑定到 NavigationGraph 节点和 heading_bin，再参与方向评分与规划。"
      },
      {
        "id": "heading-algorithm",
        "label": "Heading 算法",
        "focus": ["graph", "heading", "memory", "planner"],
        "note": "HeadingCandidate 综合 frontier、可通行性、动态风险、转向代价和历史效用。"
      },
      {
        "id": "feedback",
        "label": "反馈闭环",
        "focus": ["execution", "feedback", "memory", "heading"],
        "note": "TraversalFeedback 更新 traversal_history，并影响后续方向效用。"
      }
    ]
  },
  "stages": [
    { "label": "输入" },
    { "label": "感知与锚定" },
    { "label": "持久化记忆" },
    { "label": "Heading 评分" },
    { "label": "规划执行" }
  ],
  "nodes": [
    { "id": "inputs", "type": "external", "label": "相机 + Odometry", "sublabel": "image / pose / yaw", "tag": "ROS topics", "stage": 0, "row": 0, "width": 250, "height": 78 },
    { "id": "graph", "type": "backend", "label": "NavigationGraph", "sublabel": "node_uuid / edges / frontier", "tag": "唯一空间地图", "stage": 0, "row": 1, "width": 250, "height": 78 },
    { "id": "perception", "type": "backend", "label": "RADIO + 对象感知", "sublabel": "embedding / object / traversability", "tag": "16 angular bins", "stage": 1, "row": 0, "width": 260, "height": 82 },
    { "id": "anchor", "type": "backend", "label": "图锚定观测", "sublabel": "(map_id, node_uuid, heading_bin)", "tag": "22.5° / bin", "stage": 1, "row": 1, "width": 270, "height": 82 },
    { "id": "memory", "type": "database", "label": "VisualMemoryMap", "sublabel": "node observations / objects / coverage", "tag": "SQLite", "stage": 2, "row": 0, "width": 280, "height": 84 },
    { "id": "feedback", "type": "messagebus", "label": "TraversalFeedback", "sublabel": "outcome / duration / slip / energy", "tag": "执行历史", "stage": 2, "row": 1, "width": 280, "height": 84 },
    { "id": "heading", "type": "backend", "label": "HeadingCandidate + Utility", "sublabel": "frontier + utility - risk - turn cost", "tag": "方向评分", "stage": 3, "row": 0, "width": 290, "height": 84 },
    { "id": "planner", "type": "backend", "label": "graphnav_planner", "sublabel": "目标方向匹配 / frontier cost", "tag": "选择路径", "stage": 4, "row": 0, "width": 260, "height": 82 },
    { "id": "execution", "type": "backend", "label": "Path Follower", "sublabel": "执行边与 heading", "tag": "闭环", "stage": 4, "row": 1, "width": 260, "height": 82 }
  ],
  "flows": [
    { "id": "inputs-perception", "from": "inputs", "to": "perception", "label": "观测", "variant": "emphasis" },
    { "id": "inputs-anchor", "from": "inputs", "to": "anchor", "label": "pose + yaw" },
    { "id": "graph-anchor", "from": "graph", "to": "anchor", "label": "node_uuid" },
    { "id": "perception-anchor", "from": "perception", "to": "anchor", "label": "embedding + bins", "variant": "emphasis" },
    { "id": "anchor-memory", "from": "anchor", "to": "memory", "label": "融合观测" },
    { "id": "graph-heading", "from": "graph", "to": "heading", "label": "拓扑与物理属性" },
    { "id": "memory-heading", "from": "memory", "to": "heading", "label": "历史观测与负搜索", "variant": "emphasis" },
    { "id": "feedback-heading", "from": "feedback", "to": "heading", "label": "历史效用", "variant": "dashed", "route": "bottom-channel", "channelY": 900 },
    { "id": "heading-planner", "from": "heading", "to": "planner", "label": "utility + motion cost", "variant": "emphasis" },
    { "id": "graph-planner", "from": "graph", "to": "planner", "label": "可达边" },
    { "id": "planner-execution", "from": "planner", "to": "execution", "label": "选定路径", "variant": "emphasis" },
    { "id": "execution-feedback", "from": "execution", "to": "feedback", "label": "执行结果", "variant": "dashed" },
    { "id": "feedback-memory", "from": "feedback", "to": "memory", "label": "traversal_history", "variant": "dashed", "route": "top-channel", "channelY": 80 }
  ]
}
