<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">
  <model name="lane_water_tank">
    <static>true</static>
    <link name="body">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://lane_water_tank/visual.dae</uri>
          </mesh>
        </geometry>
