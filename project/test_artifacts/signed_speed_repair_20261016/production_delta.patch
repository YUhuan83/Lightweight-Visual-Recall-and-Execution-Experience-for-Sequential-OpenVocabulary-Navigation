+def longitudinal_ground_speed(vx: float, vy: float, forward_x: float,
+                              forward_y: float) -> float:
+    """Signed horizontal speed; velocity and forward share world coordinates.
+
+    Keep horizontal speed magnitude separately for stopping and gear changes.
+    Missing/degenerate heading cannot establish the direction of motion.
+    """
+    if not all(math.isfinite(v) for v in (vx, vy, forward_x, forward_y)):
+        return float('nan')
+    norm = math.hypot(forward_x, forward_y)
+    if not math.isfinite(norm) or norm < 1e-6:
+        return float('nan')
+    return vx * (forward_x / norm) + vy * (forward_y / norm)
 
 
