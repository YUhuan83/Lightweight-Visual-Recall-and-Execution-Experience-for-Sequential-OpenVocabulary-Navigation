+void Mapper::validate_robot_profile() const
+{
+  const auto optional_limit=[](double value) { return std::isfinite(value) && (value == -1. || value >= 0.); };
+  if (robot_profile_id_.empty() || !std::isfinite(robot_minimum_clearance_) || robot_minimum_clearance_ < 0. ||
+      !std::isfinite(robot_footprint_padding_) || robot_footprint_padding_ < 0. ||
+      !optional_limit(robot_body_front_extent_) || !optional_limit(robot_body_rear_extent_) ||
+      !optional_limit(robot_body_half_width_) || !optional_limit(robot_body_height_) ||
+      !optional_limit(robot_ground_clearance_) || !optional_limit(robot_min_turning_radius_))
+    throw std::invalid_argument("Invalid robot geometry/profile limits");
+  const bool any_body = robot_body_front_extent_ >= 0. || robot_body_rear_extent_ >= 0. || robot_body_half_width_ >= 0.;
+  if (any_body)
+  {
+    if (robot_body_front_extent_ < 0. || robot_body_rear_extent_ < 0. || robot_body_half_width_ < 0.)
+      throw std::invalid_argument("Planar body extents must be specified together");
+    const double inscribed=std::min({robot_body_front_extent_,robot_body_rear_extent_,robot_body_half_width_}) + robot_footprint_padding_;
+    if (robot_minimum_clearance_ + 1.e-9 < inscribed)
+      throw std::invalid_argument("Graph clearance is smaller than the configured body inscribed radius");
+  }
 }
 
