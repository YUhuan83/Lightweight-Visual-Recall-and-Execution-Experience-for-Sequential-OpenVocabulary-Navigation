+float physical_value(const std::map<std::string,std::vector<float>>& metadata,
+                     const std::string& key,float fallback=0.f)
+{
+  const auto value=metadata.find(key);
+  return value==metadata.end() || value->second.empty() ? fallback : value->second.front();
+}
+
+template<typename Properties>
+bool retain_measured_violation(const Properties& previous,bool complete,bool violation)
+{
+  const float confidence=physical_value(previous.metadata,"physical_confidence");
+  return !complete && !violation && previous.physical_observed_at_ns>0 &&
+      physical_value(previous.metadata,"physical_violation_observed")==1.f &&
+      physical_value(previous.metadata,"physical_feasible",1.f)==0.f &&
+      std::isfinite(confidence) && confidence>=.7f && confidence<=1.f;
+}
+}
