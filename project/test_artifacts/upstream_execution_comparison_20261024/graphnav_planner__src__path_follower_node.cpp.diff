+  void update_traversal_feedback(const geometry_msgs::msg::PoseStamped& robot_pose,
+                                 const Eigen::Vector3d& robot_position)
+  {
+    if (!attempt_active_ || attempt_reported_ || !feedback_pub_)
+    {
+      return;
+    }
+    const double now = this->now().seconds();
+    const double remaining = (attempt_goal_ - robot_position).norm();
+    if (!attempt_initialized_)
+    {
+      attempt_start_pose_ = robot_pose.pose;
+      attempt_start_position_ = robot_position;
+      last_progress_position_ = robot_position;
+      attempt_started_at_ = now;
+      last_progress_at_ = now;
+      attempt_distance_ = remaining;
+      commanded_heading_ = std::atan2(attempt_goal_.y() - robot_position.y(),
+                                      attempt_goal_.x() - robot_position.x());
+      attempt_initialized_ = true;
+    }
+    else if ((robot_position - last_progress_position_).norm() >= traversal_min_progress_)
+    {
+      last_progress_position_ = robot_position;
+      last_progress_at_ = now;
+    }
+
+    std::uint8_t outcome = graphnav_msgs::msg::TraversalFeedback::OUTCOME_UNKNOWN;
+    bool retryable = false;
+    if (remaining <= traversal_success_tolerance_)
+    {
+      outcome = graphnav_msgs::msg::TraversalFeedback::OUTCOME_SUCCEEDED;
+    }
+    else if (now - last_progress_at_ >= traversal_stuck_timeout_)
+    {
+      outcome = graphnav_msgs::msg::TraversalFeedback::OUTCOME_STUCK;
+      retryable = true;
+    }
+    if (outcome == graphnav_msgs::msg::TraversalFeedback::OUTCOME_UNKNOWN)
+    {
+      return;
+    }
+
+    graphnav_msgs::msg::TraversalFeedback feedback;
+    feedback.header = robot_pose.header;
+    const auto stamp_now = this->get_clock()->now();
+    const auto nanoseconds = stamp_now.nanoseconds();
+    feedback.header.stamp.sec = static_cast<int32_t>(nanoseconds / 1000000000LL);
+    feedback.header.stamp.nanosec = static_cast<uint32_t>(nanoseconds % 1000000000LL);
+    feedback.start_pose = attempt_start_pose_;
+    feedback.end_pose = robot_pose.pose;
+    feedback.commanded_heading = commanded_heading_;
+    feedback.observed_heading = tf2::getYaw(robot_pose.pose.orientation);
+    feedback.commanded_distance = static_cast<float>(attempt_distance_);
+    feedback.observed_distance = static_cast<float>((robot_position - attempt_start_position_).norm());
+    feedback.duration = static_cast<float>(std::max(0.0, now - attempt_started_at_));
+    feedback.outcome = outcome;
+    feedback.retryable = retryable;
+    feedback_pub_->publish(feedback);
+    attempt_reported_ = true;
+  }
