+TEST(ExplorationBackoff, LocalAttemptDoesNotExcludeOtherDestinationsOrInferBlockedEdges)
+{
+  graphnav_planner::ExplorationBackoff policy;
+  geometry_msgs::msg::PoseStamped refusal;
+  refusal.header.frame_id = "spot1/odom"; refusal.header.stamp.sec = 100;
+  refusal.pose.position.x = 20.;
+  auto destination = refusal.pose.position;
+  geometry_msgs::msg::Point origin; origin.x = 1.;
+  std::vector<geometry_msgs::msg::Point> path(2); path[1].x = 20.;
+  policy.remember(refusal.header, refusal.pose.position, destination, "a", path);
+  ASSERT_TRUE(policy.reject(refusal,110000000000LL,true,origin));
+  EXPECT_TRUE(policy.blocked(destination,111000000000LL,3.));
+  auto alternative = destination; alternative.y = 4.;
+  EXPECT_FALSE(policy.blocked(alternative,111000000000LL,3.));
+  EXPECT_FALSE(policy.blocked(origin,111000000000LL,3.));
+  EXPECT_TRUE(policy.active_edges(111000000000LL).empty());
 }
 
