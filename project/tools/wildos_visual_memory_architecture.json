{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "WildOS 图锚定方向视觉记忆",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [1440, 900]
  },
  "layout": {
    "mode": "grid",
    "origin": [70, 90],
    "cols": 4,
    "gapX": 70,
    "gapY": 90,
    "cellW": 270,
    "cellH": 122
  },
  "components": [
    {
      "id": "sensor_input",
      "type": "external",
      "label": "相机 / LiDAR / Odom / TF",
      "sublabel": "同一时刻观测输入",
      "tag": "输入",
      "row": 0,
      "col": 0,
    },
    {
      "id": "wildos_perception",
      "type": "backend",
      "label": "WildOS / RADIO 感知",
      "sublabel": "语义可通行性、frontier、场景 embedding",
      "tag": "感知",
      "row": 0,
      "col": 1,
    },
    {
      "id": "navigation_graph",
      "type": "backend",
      "label": "NavigationGraph",
      "sublabel": "唯一空间拓扑真值",
      "tag": "几何地图",
      "row": 1,
      "col": 0,
    },
    {
      "id": "heading_memory",
      "type": "database",
      "label": "node_uuid × heading_bin 视觉记忆",
      "sublabel": "同一节点不同方向独立融合",
      "tag": "记忆索引",
      "row": 1,
      "col": 1,
    },
    {
      "id": "sqlite_memory",
      "type": "database",
      "label": "SQLite 持久化记忆",
      "sublabel": "节点观测、对象、搜索、反馈",
      "tag": "持久化",
      "row": 2,
      "col": 0,
    },
    {
      "id": "semantic_objects",
      "type": "database",
      "label": "语义对象地图",
      "sublabel": "house / door / tree + approach pose",
      "tag": "对象记忆",
      "row": 2,
      "col": 1,
    },
    {
      "id": "relation_query",
      "type": "backend",
      "label": "关系型目标查询",
      "sublabel": "左侧第三个房子 / 道路末端目标",
      "tag": "语言关系",
      "row": 3,
      "col": 0,
    },
    {
      "id": "planner",
      "type": "backend",
      "label": "Heading-aware Planner",
      "sublabel": "frontier utility + 物理/动态/转向代价",
      "tag": "规划",
      "row": 1,
      "col": 2,
    },
    {
      "id": "execution",
      "type": "backend",
      "label": "Nav2 / 车辆执行",
      "sublabel": "路径跟随、控制、碰撞/卡住反馈",
      "tag": "执行",
      "row": 2,
      "col": 2,
    },
    {
      "id": "beamng",
      "type": "external",
      "label": "BeamNG.tech",
      "sublabel": "真实车辆物理与动态环境",
      "tag": "仿真",
      "row": 3,
      "col": 2,
    }
  ],
  "boundaries": [
    { "kind": "region", "label": "WildOS 感知与图构建", "wraps": ["sensor_input", "wildos_perception", "navigation_graph"], "pad": 24 },
    { "kind": "region", "label": "持久化视觉记忆层", "wraps": ["heading_memory", "sqlite_memory", "semantic_objects", "relation_query"], "pad": 24 },
    { "kind": "region", "label": "规划与执行闭环", "wraps": ["planner", "execution", "beamng"], "pad": 24 }
  ],
  "connections": [
    { "id": "sensor_to_perception", "from": "sensor_input", "to": "wildos_perception", "label": "同步图像 / 几何 / 位姿", "variant": "default", "route": "auto" },
    { "id": "sensor_to_graph", "from": "sensor_input", "to": "navigation_graph", "label": "OccupancyGrid / Odom / TF", "variant": "default", "route": "auto" },
    { "id": "perception_to_graph", "from": "wildos_perception", "to": "navigation_graph", "label": "frontier + semantic scores", "variant": "default", "route": "auto" },
    { "id": "graph_to_memory", "from": "navigation_graph", "to": "heading_memory", "label": "node_uuid × heading_bin 锚定", "variant": "emphasis", "route": "auto" },
    { "id": "perception_to_memory", "from": "wildos_perception", "to": "heading_memory", "label": "RADIO embedding + 方向评分", "variant": "emphasis", "route": "auto" },
    { "id": "memory_to_sqlite", "from": "heading_memory", "to": "sqlite_memory", "label": "融合 / 持久化", "variant": "default", "route": "auto" },
    { "id": "memory_to_objects", "from": "heading_memory", "to": "semantic_objects", "label": "对象观测与身份关联", "variant": "default", "route": "auto" },
    { "id": "objects_to_query", "from": "semantic_objects", "to": "relation_query", "label": "对象 + 空间关系", "variant": "default", "route": "auto" },
    { "id": "graph_to_planner", "from": "navigation_graph", "to": "planner", "label": "frontier / edges / physical profile", "variant": "default", "route": "auto" },
    { "id": "memory_to_planner", "from": "heading_memory", "to": "planner", "label": "memory prior + uncertainty + failure penalty", "variant": "emphasis", "route": "auto" },
    { "id": "query_to_planner", "from": "relation_query", "to": "planner", "label": "approach node + heading", "variant": "emphasis", "route": "auto" },
    { "id": "planner_to_execution", "from": "planner", "to": "execution", "label": "heading-aware path / goal", "variant": "default", "route": "auto" },
    { "id": "execution_to_beamng", "from": "execution", "to": "beamng", "label": "cmd_vel / VehicleControl", "variant": "default", "route": "auto" },
    { "id": "beamng_to_execution", "from": "beamng", "to": "execution", "label": "odom / collision / stuck", "variant": "default", "route": "auto" },
    { "id": "execution_to_memory", "from": "execution", "to": "heading_memory", "label": "TraversalFeedback 回写", "variant": "emphasis", "route": "auto" }
  ],
  "cards": [
    { "dot": "cyan", "title": "核心原则", "items": ["NavigationGraph 是唯一空间地图", "视觉记忆挂在 node_uuid × heading_bin", "不修改 explored_radius 或 frontier"] },
    { "dot": "emerald", "title": "第二轮任务", "items": ["识别当前地图", "查询历史节点与方向", "复用 approach pose", "视觉确认后执行并回写反馈"] }
  ]
}
